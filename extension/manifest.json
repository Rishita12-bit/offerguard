{
  "manifest_version": 3,
  "name": "OfferGuard",
  "version": "0.2.0",
  "description": "Verify internship and job offers before you pay.",
  "action": { "default_popup": "popup.html", "default_title": "OfferGuard" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8787/*", "https://*.onrender.com/*"]
}
